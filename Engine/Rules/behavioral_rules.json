{
  "rules": [
    {
      "id": "encoded_powershell",
      "name": "Encoded PowerShell Execution",
      "event": "process_start",
      "severity": "HIGH",
      "threshold": 1,
      "window_seconds": null,
      "conditions": [
        {"field": "image", "op": "contains", "value": "powershell"},
        {"field": "cmdline", "op": "regex", "value": "-[eE]nc"}
      ]
    },
    {
      "id": "credential_dumper_mimikatz",
      "name": "Credential Dumper (mimikatz.exe)",
      "event": "process_start",
      "severity": "CRITICAL",
      "threshold": 1,
      "window_seconds": null,
      "conditions": [
        {"field": "image", "op": "eq", "value": "mimikatz.exe"}
      ]
    },
    {
      "id": "repeated_suspicious_ip_connects",
      "name": "Repeated Connections to Suspicious IP Range",
      "event": "net_connect",
      "severity": "MEDIUM",
      "threshold": 5,
      "window_seconds": 30,
      "conditions": [
        {"field": "remote_ip", "op": "startswith", "value": "185."}
      ]
    }
  ]
}
