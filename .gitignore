# Scratch / temp
*.tmp
*.bak

# Large binaries kept on disk but out of git history
# (.exe = PyInstaller output, regenerable + slated for Phase 3 removal;
#  .ips = compiled rules blob, regenerable from Rules-full.yar)
Plugin/SentinelServices/*.exe
Engine/Signatures/*.ips

# Subagent-driven-development scratch (progress ledger, briefs)
.superpowers/

# PyInstaller build outputs — never commit PE binaries (the Aria scanner
# quarantines PE bytes found inside .git pack objects).
/build/
/dist/
*.spec.bak

Client/
docs/
scripts/
tests/

pytest.ini
run_dev.py
.claude